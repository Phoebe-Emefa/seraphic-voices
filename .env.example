SANITY_REVALIDATE_SECRET=

# Google Search Console — HTML tag verification value (optional).
# Add the property at https://search.google.com/search-console then paste the content value here.
GOOGLE_SITE_VERIFICATION=

EMAIL=
EMAIL_PASS=
