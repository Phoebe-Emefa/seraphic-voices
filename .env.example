NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=revamp
NEXT_PUBLIC_SANITY_API_VERSION=2023-09-20

# Server-only: shared secret for Sanity publish webhooks (POST /api/revalidate).
# Set this after ISR is on so publishes bust the 60s cache instead of waiting.
SANITY_REVALIDATE_SECRET=

# Google Search Console — HTML tag verification value (optional).
# Add the property at https://search.google.com/search-console then paste the content value here.
GOOGLE_SITE_VERIFICATION=

EMAIL=
EMAIL_PASS=
