NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=revamp
NEXT_PUBLIC_SANITY_API_VERSION=2023-09-20

# Server-only: shared secret for Sanity publish webhooks (POST /api/revalidate).
